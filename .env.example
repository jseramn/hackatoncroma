# ── Croma ────────────────────────────────────────────────────────────────
# Powers the live-data MCP tools. Get a free key: https://platform.usecroma.com/sign-up
CROMA_API_KEY=

# ── Neon / Mallanet Verify ───────────────────────────────────────────────
# Optional. Postgres URL with DML on schema `verify` only.
# If omitted, verify tools use the in-memory seed (verify-operator-001).
# DATABASE_URL=

# Optional — MCP endpoint override (defaults to https://api.croma.run/mcp)
# CROMA_MCP_URL=https://api.croma.run/mcp

# ── Model (one required) ─────────────────────────────────────────────────
# GLM Coding Plan (preferred when set): OpenAI-compatible coding endpoint
# https://api.z.ai/api/coding/paas/v4 — not the general /api/paas/v4 API
# GLM_API_KEY=
# ZAI_API_KEY=            # alias for GLM_API_KEY
# GLM_BASE_URL=           # optional override (default: coding paas v4 above)
# GLM_MODEL=              # optional override (default: glm-4.5)

# Claude: runs claude-opus-5
# ANTHROPIC_API_KEY=

# Groq fallback: runs openai/gpt-oss-120b — https://console.groq.com/keys
GROQ_API_KEY=

# ── Rate limiting (optional) ─────────────────────────────────────────────
# When both are set, /api/chat is limited to 10 requests/min per IP.
# Create a Redis database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
