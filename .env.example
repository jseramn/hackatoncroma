# ── Croma ────────────────────────────────────────────────────────────────
# Powers the live-data MCP tools. Get a free key: https://platform.usecroma.com/sign-up
CROMA_API_KEY=

# Optional — MCP endpoint override (defaults to https://api.croma.run/mcp)
# CROMA_MCP_URL=https://api.croma.run/mcp

# ── Model (one required) ─────────────────────────────────────────────────
# Claude (preferred when set): runs claude-opus-5
# ANTHROPIC_API_KEY=

# Groq fallback: runs openai/gpt-oss-120b — https://console.groq.com/keys
GROQ_API_KEY=

# ── Rate limiting (optional) ─────────────────────────────────────────────
# When both are set, /api/chat is limited to 10 requests/min per IP.
# Create a Redis database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
